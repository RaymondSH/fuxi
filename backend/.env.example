# 复制成 .env 后填入真实值。.env 永不提交。
#
# AI 服务统一一套配置：智谱 /api/paas/v4/ 兼容 OpenAI 协议，聊天/视觉/向量共用一个 Key。
# 换兼容 OpenAI 协议的 provider（智谱/DeepSeek/月之暗面/OpenAI）只改下面几项即可。

# ── 数据库 ──
# linux-server 已建好库与角色（详见 docs/deploy.md）。
# 后端跑在服务器上时直接用 localhost；本地 Mac 开发时先开 SSH 隧道再连 localhost。
DATABASE_URL=postgresql://fuxi:fuxi@localhost:5432/fuxi

# ── AI 服务（智谱 GLM）──
API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CHAT_MODEL=glm-5.2
VISION_MODEL=glm-4.6v
EMBED_MODEL=embedding-3
EMBED_DIM=1536

# ── 文档分块（长文档切块后再逐块向量化；CHUNK_SIZE/CHUNK_OVERLAP 控制）──
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CHUNK_MIN_SIZE=80

# ── 抓取微信公众号用 Jina Reader ──
JINA_READER_PREFIX=https://r.jina.ai/

# ── 原始文件存储 ──
# STORAGE_BACKEND=local 落服务器本地目录（默认，零依赖）；=r2 用 Cloudflare R2（S3 兼容）。
# 暂未开通 R2 时保持 local 兜底即可，摄取的原始文件（pdf/docx/图片等）会落到 STORAGE_LOCAL_ROOT。
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/opt/fuxi/raw
# R2 凭据（STORAGE_BACKEND=r2 时才用，留空自动回退 local）
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fuxi
R2_PUBLIC_BASE_URL=

# ── Elasticsearch 关键词检索（ik 中文分词）──
# 留空则关键词路回退 Postgres ILIKE；填地址即走 ES（需先部署 ES8+ik，见 deploy/es/）
ES_URL=http://127.0.0.1:9200
ES_TIMEOUT=5.0
